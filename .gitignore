# --- machine-local & identity (Rule 7) -------------------------------------
CLAUDE.local.md

# --- incoming file migration staging (not yet triaged into a real tier) ----
_drop-off/

# --- throwaway scripts (Rule 1) --------------------------------------------
scrap_scripts/

# --- large-file dataset: keep tracked READMEs, ignore the heavy media ------
dataset/raw-video/
dataset/**/*.mp4
dataset/**/*.mov
dataset/**/*.mkv
dataset/**/*.avi
dataset/**/*.png
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.npy
dataset/**/*.npz
# but never ignore the explanatory READMEs / placeholders
!dataset/**/README.md
!dataset/**/.gitkeep
# generated pipeline output (overlays + snapshot JSON) — regenerable, never tracked
dataset/pipeline-out/
# mined card-crop dataset (PNGs + manifest.jsonl) — regenerable via utils/python/mine_card_crops.py
dataset/crops/

# --- third-party reference inputs, bulk/verbatim (Rule 6) ------------------
# Card art and raw wiki caches are reference inputs for the pipeline, not
# redistributable content. Transcribed/transformative .md under knowledge-base/
# stays tracked; bulk verbatim fetches and downloaded art do not.
knowledge-base/card-art/*
knowledge-base/wiki/_raw_cache/
!knowledge-base/card-art/README.md

# --- trained model artifacts (can be large; regenerable) -------------------
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.weights
checkpoints/
runs/
# regenerable training/eval dumps under models/ (authoritative numbers -> DEV-LOG.md)
models/*.log
models/*.txt

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- os / editor junk ------------------------------------------------------
Thumbs.db
.DS_Store
.vscode/
.idea/

# Claude Code machine-local settings (keep out of the public repo)
.claude/settings.local.json
