# Normalize text to LF in the repo (this deploys on Linux via GitHub Pages/Actions).
* text=auto eol=lf

# Explicit text types
*.md   text
*.html text
*.css  text
*.js   text
*.py   text
*.json text
*.yml  text
*.yaml text

# Binary assets (never normalize)
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.mp4  binary
*.mov  binary
*.mkv  binary
